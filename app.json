{
  "expo": {
    "name": "VoiceStudyFlow",
    "slug": "VoiceStudyFlow",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "voicestudyflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.nahlah.voicestudyflow",
      "buildNumber": "11",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSPhotoLibraryUsageDescription": "Used only when you choose to add a page photo or image from your library to study.",
        "NSPhotoLibraryAddUsageDescription": "Used only when you choose to save a study file or card image to your Photos.",
        "NSMicrophoneUsageDescription": "VoiceStudyFlow uses the microphone only while you hold the voice button, so you can ask about your books, answer quizzes and reply to focus check-ins by voice."
      },
      "appleTeamId": "35WLZWD8D6",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "io.nahlah.voicestudyflow",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#5f7bf5",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E1A33",
          "dark": {
            "backgroundColor": "#0E1A33"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "VoiceStudyFlow uses the microphone only while you hold the voice button, so you can ask about your books, answer quizzes and reply to focus check-ins by voice."
        }
      ],
      "expo-localization",
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "VoiceStudyFlow uses the microphone only while you hold the voice button, so you can ask about your books, answer quizzes and reply to focus check-ins by voice.",
          "speechRecognitionPermission": "Speech is recognized by Apple to turn your voice requests into text. Recordings are not stored.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "@bacons/apple-targets",
      "expo-iap",
      "./plugins/withXcode26Fixes",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c1c47712-e163-4649-bc74-79d45519e09f"
      }
    },
    "owner": "nahla900",
    "locales": {
      "ar": "./locales/ar.json"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c1c47712-e163-4649-bc74-79d45519e09f",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
